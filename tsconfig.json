{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/pages/**/*",
    "src/layouts/**/*",
    "src/components/**/*",
    "src/lib/**/*",
    "src/features/**/*",
    "src/main.tsx",
    "src/App.tsx",
    "src/vite-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/app",
    "src/lib/auth.ts",
    "src/lib/supabase/server.ts",
    "src/features/auth/SignupForm.tsx",
    "src/features/auth/LoginForm.tsx",
    "src/features/auth/ResetPasswordForm.tsx",
    "src/features/auth/UpdatePasswordForm.tsx",
    "src/features/profile/ProfileForm.tsx",
    "src/features/admin/RealtimeRefresh.tsx",
    "src/features/admin/StudentAttendanceSearch.tsx",
    "src/features/admin/UserManagementActions.tsx"
  ]
}
